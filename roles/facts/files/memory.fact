#!/bin/bash
# memtotal_mb is MemTotal in MiB. total_mb is 95% of that (slurm.conf
# RealMemory). Integer division; do not emit a float (NHC / Jinja |int).
memtotal_kb=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
memtotal_mb=$((memtotal_kb / 1024))
total_mb=$((memtotal_mb * 95 / 100))
echo "{ \"memtotal_mb\": ${memtotal_mb}, \"total_mb\": ${total_mb} }"

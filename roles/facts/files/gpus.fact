#!/bin/bash
# PCI vendor:device IDs and NVSwitch count from the bus, so they exist
# before a driver is installed. IDs rather than lspci names: an old pci.ids
# does not know newer GPUs (Ubuntu 22.04 shows the H100 as "Device").
# Class 0300 = VGA, 0302 = 3D (same set the old name match counted);
# NVSwitch is 0680 (other bridge).
count=0
pci_ids=""
nvswitch_count=0
if command -v lspci >/dev/null 2>&1; then
    gpu_ids=$(lspci -n -d 10de: | awk '$2 == "0300:" || $2 == "0302:" {print $3}')
    count=$(printf '%s' "$gpu_ids" | grep -c .)
    pci_ids=$(printf '%s\n' "$gpu_ids" | grep . | sort -u | sed 's/.*/"&"/' | paste -sd, -)
    nvswitch_count=$(lspci -n -d 10de: | awk '$2 == "0680:"' | wc -l)
    nvswitch_count=${nvswitch_count// /}
fi
echo "{ \"count\": ${count}, \"pci_ids\": [${pci_ids}], \"nvswitch_count\": ${nvswitch_count} }"

# kosmos: gaia booted 22.04 with iommu=pt (hand-edited
# GRUB_CMDLINE_LINUX_DEFAULT, 2025-08). AMD EPYC 7763 with the AMD IOMMU on
# and 40GbE/10GbE NICs, no VMs: passthrough mode skips IOMMU translation for
# the host's own DMA. Kept as it was; remove the line to run with the kernel
# default (translated).
kernel_cmdline_extra: "iommu=pt"
